PLO_DATA_DIR=/app/data
PLO_DEMO_MODE=0
# Services facultatifs de l’onglet Itinéraire. Les coordonnées manuelles restent utilisables sans géocodage.
AXIOLOAD_OSRM_URL=https://router.project-osrm.org
AXIOLOAD_NOMINATIM_URL=https://nominatim.openstreetmap.org
AXIOLOAD_GEOCODE_COUNTRIES=fr,be,nl,de,es,it,lu,ch

# Phase de test : conserve exactement les deux comptes ci-dessous et supprime
# les comptes supplémentaires au démarrage. Passer cette valeur à 0 avant la production.
PLO_TEST_ACCOUNTS_ONLY=1

# Compte Centre de gestion de test.
PLO_SUPER_ADMIN_EMAIL=b.olivier@circoe.com
PLO_SUPER_ADMIN_USERNAME=superadmn
PLO_SUPER_ADMIN_PASSWORD=0123456789

# Compte utilisateur de test actif immédiatement, sans invitation ni lien d’activation.
PLO_TEST_USER_EMAIL=olivierbaptiste6@gmail.com
PLO_TEST_USER_PASSWORD=0123456789

# Mettre à 1 uniquement lorsque l’application est servie en HTTPS.
PLO_COOKIE_SECURE=0
