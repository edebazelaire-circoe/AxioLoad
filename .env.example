PLO_DATA_DIR=/app/data
PLO_DEMO_MODE=0

# Services facultatifs de l’onglet Itinéraire. Pour la production, privilégiez
# des instances dédiées ou des fournisseurs disposant d’un SLA et de quotas maîtrisés.
AXIOLOAD_OSRM_URL=https://router.project-osrm.org
AXIOLOAD_NOMINATIM_URL=https://nominatim.openstreetmap.org
AXIOLOAD_GEOCODE_COUNTRIES=fr,be,nl,de,es,it,lu,ch

# Production : toujours désactivé. N’activer qu’en environnement de test isolé.
PLO_TEST_ACCOUNTS_ONLY=0

# Compte Centre de gestion. Ne stockez jamais le vrai mot de passe dans Git.
PLO_SUPER_ADMIN_EMAIL=superadmin@example.invalid
PLO_SUPER_ADMIN_USERNAME=superadmin
PLO_SUPER_ADMIN_PASSWORD=

# Uniquement si PLO_TEST_ACCOUNTS_ONLY=1 dans un environnement de test isolé.
PLO_TEST_USER_EMAIL=test-user@example.invalid
PLO_TEST_USER_PASSWORD=

# Clé maître utilisée pour chiffrer les secrets IA stockés. Générer une valeur
# aléatoire forte dans le gestionnaire de secrets de l’environnement.
PLO_DOCUMENT_SECRET_KEY=

# Production HTTPS : 1. Pour un développement HTTP local uniquement : 0.
PLO_COOKIE_SECURE=1
